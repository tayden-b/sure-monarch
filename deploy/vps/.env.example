# ===========================================================================
# Sure on a public VPS — environment file
# ===========================================================================
# Copy to `.env` (bin/setup-vps does this for you and fills in everything it
# can generate locally). Never commit `.env` — it contains live secrets.
#
# Legend: [auto]   = bin/setup-vps generates a value for you
#         [manual] = you must paste a value from an external site (or leave blank)
#         [opts]   = optional, safe defaults provided
# ===========================================================================

# --- Required ---------------------------------------------------------------

# [manual] Public hostname Caddy serves HTTPS for — the DNS A record must point
# at this VPS. Example: money.example.com
# Rehearsal/local testing: use "localhost" (Caddy self-signs; browsers warn).
APP_DOMAIN=localhost

# [opts] Which Caddy config Caddy runs. ./Caddyfile = automatic HTTPS (Let's
# Encrypt for public domains; internal self-signed CA for localhost).
# ./Caddyfile.internal = `tls internal` — for rehearsing on a fake NON-localhost
# name (e.g. sure.test in /etc/hosts) with no public DNS.
CADDYFILE=./Caddyfile

# [auto] Rails session/credential signing key. Generate: openssl rand -hex 64
SECRET_KEY_BASE=

# [opts] Database name / user inside the postgres container. Defaults are fine.
POSTGRES_DB=sure_production
POSTGRES_USER=sure

# [auto] Database password. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# [opts] Enables self-hosting mode (unlimited features, no managed billing). Keep true.
SELF_HOSTED=true

# [opts] Who may create accounts: open | closed | invite_only.
# Once you've made your own account, set this to "closed" and `docker compose up -d`.
ONBOARDING_STATE=open

# [opts] SSL behavior. Both TRUE — Caddy terminates TLS at the edge and tells
# Rails the request was HTTPS. Leave alone unless you know why you're changing it.
RAILS_FORCE_SSL=true
RAILS_ASSUME_SSL=true

# [opts] Public origin Sure uses for Plaid redirect/webhook URLs.
# Blank = derived from APP_DOMAIN as https://<APP_DOMAIN>. Only set this if the
# public URL differs from APP_DOMAIN for some reason.
APP_HOST=

# --- Active Record encryption ----------------------------------------------
# [auto] Encrypts API keys/secrets stored in the DB. If left blank, Sure derives
# them from SECRET_KEY_BASE. Generating explicit keys is recommended: they let
# you rotate SECRET_KEY_BASE without losing access to encrypted data.
# Generate each with: openssl rand -hex 32
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- WebAuthn / passkeys (optional) -----------------------------------------
# [auto] bin/setup-vps fills these from APP_DOMAIN. RP ID = registrable domain
# (no scheme); allowed origins = the full https origin. Leave blank to disable.
WEBAUTHN_RP_ID=
WEBAUTHN_ALLOWED_ORIGINS=

# --- AI features (optional; all blank = AI off) ------------------------------
# [manual] OpenAI-compatible API key — https://platform.openai.com/api-keys
# (or point OPENAI_URI_BASE at a local model server like Ollama/LM Studio)
OPENAI_ACCESS_TOKEN=
# [opts] e.g. gpt-4o-mini; blank = app default
OPENAI_MODEL=
# [opts] custom endpoint base, e.g. http://host.docker.internal:11434/v1
OPENAI_URI_BASE=
# [opts] per-request timeout seconds
OPENAI_REQUEST_TIMEOUT=60
# [opts] seconds the chat UI waits for a reply before showing "no response"
AI_RESPONSE_TIMEOUT=90

# [manual] Jev/TypeSafe transaction categorization — https://typesafe.ai
JEV_API_KEY=
CATEGORIZATION_PROVIDER=
JEV_ENDPOINT=
JEV_MODEL=

# --- External agents / MCP (optional; all blank = static MCP tokens off) ------
# [manual] Static bearer tokens for POST /mcp. MCP_USER_EMAIL must match an
# existing Sure user — either token acts as that user. OAuth clients (Claude.ai
# etc.) register themselves and don't need these.
# Generate each with: openssl rand -hex 32
#
#   MCP_API_TOKEN          read + write — every tool in the registry
#   MCP_API_TOKEN_READONLY read-only   — get_*/list_*/search_* tools only;
#                          write tools are hidden and answer "Unknown tool"
#
# Read-only is the default recommendation for unattended agents (scheduled
# digests, monitoring bots, Devin workspaces). Keep read + write for
# interactive assistants you trust to make changes.
MCP_API_TOKEN=
MCP_API_TOKEN_READONLY=
MCP_USER_EMAIL=

# --- Market data (optional) ---------------------------------------------------
# [manual] Twelve Data API key (quotes + FX) — https://twelvedata.com → API Key.
# Blank + the two providers below = free Yahoo Finance data, no key needed.
TWELVE_DATA_API_KEY=
EXCHANGE_RATE_PROVIDER=yahoo_finance
SECURITIES_PROVIDER=yahoo_finance
# [manual] Brandfetch client ID for bank/merchant logos — https://brandfetch.com
BRAND_FETCH_CLIENT_ID=

# --- Plaid (optional; Sandbox keys first, production Trial later) -------------
# [manual] Plaid dashboard → Developers → Keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# [opts] sandbox | development | production — start with sandbox
PLAID_ENV=sandbox
# [opts] show/reconcile pending Plaid transactions (1=on, 0=off)
PLAID_INCLUDE_PENDING=1
# [opts] days of history to request on first link; blank = Plaid's max (730)
PLAID_HISTORY_DAYS=
#
# [auto] bin/setup-vps fills these from APP_DOMAIN:
#   PLAID_REDIRECT_URI  → https://<APP_DOMAIN>/accounts
#   PLAID_WEBHOOK_URL   → https://<APP_DOMAIN>/webhooks/plaid
# Then paste the redirect URI into the Plaid dashboard → Team settings → API →
# allowed redirect URIs. There is no dashboard allowlist for webhooks — Sure
# registers PLAID_WEBHOOK_URL with Plaid inside each link token.
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URL=
# [opts] EU webhook path — only needed if you link EU-region institutions.
PLAID_EU_WEBHOOK_URL=

# --- Email / SMTP (optional; blank = no outgoing email) -----------------------
# [manual] Any SMTP provider works; Resend free tier is a good fit — https://resend.com
SMTP_ADDRESS=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_ENABLED=true
SMTP_TLS_SKIP_VERIFY=false
# [opts] From address, e.g. Sure <sure@yourdomain.com>
EMAIL_SENDER=

# --- Sidekiq web UI (optional) ------------------------------------------------
# [opts] /sidekiq already requires the first (super-admin) login; set BOTH to
# add a second basic-auth layer.
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# --- Monarch archive ----------------------------------------------------------
# [opts] Container path where ./data/archive is mounted read-only.
# The Monarch importer reads from here — do not change without editing
# docker-compose.yml to match.
MONARCH_ARCHIVE_PATH=/archive

# [opts] 1 = every imported Monarch transaction lands in the needs-review
# queue (recommended: the importer can't know which ones you had already
# reconciled). 0 = only Monarch's own needsReview flags apply.
IMPORT_AUTO_FLAG_NEEDS_REVIEW=1
