<%# locals: (accounts:) %>

<%# hide_from_list accounts never render in groups — they live in the page's
    "Hidden accounts" section instead — but their balances still count in
    net worth (see BalanceSheet). %>
<% listed_accounts = accounts.reject(&:hide_from_list?) %>

<% if listed_accounts.any? %>
  <% ActiveRecord::Associations::Preloader.new(
       records: listed_accounts,
       associations: [
         :account_shares,
         :accountable,
         :plaid_account,
         :simplefin_account,
         { account_providers: :provider },
         { logo_attachment: :blob }
       ]
     ).call %>
<% end %>
<% listed_accounts.group_by(&:accountable_type).sort_by { |type, _| Accountable::TYPES.index(type) || Float::INFINITY }.each do |group, accounts| %>
  <div class="bg-container-inset p-1 rounded-xl">
    <div class="flex items-center px-4 py-2 text-xs font-medium text-secondary">
      <p><%= Accountable.from_type(group).display_name %></p>
      <span class="text-subdued mx-2">&middot;</span>
      <p><%= accounts.count %></p>

      <% unless accounts.any?(&:syncing?) %>
        <p class="ml-auto privacy-sensitive"><%= totals_by_currency(collection: accounts, money_method: :balance_money) %></p>
      <% end %>
    </div>
    <div class="bg-container rounded-lg shadow-border-xs overflow-hidden">
      <% accounts.each_with_index do |account, index| %>
        <%= render "accounts/account", account: account %>
        <% unless index == accounts.count - 1 %>
          <%= render "shared/ruler" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
