<%# locals: (budget:, editable:) %>

<%# Monarch's flex number: one monthly pool for spend no category envelope
    claims. The amount is a slice of `budgeted_spending`, so it lives beside
    the plan here rather than among the category rows it deliberately isn't. %>
<% pacing = budget.flex_suggested_daily_spending %>
<% currency = Money::Currency.new(budget.currency) %>

<div id="<%= dom_id(budget, :flex_budget) %>" class="w-full bg-container rounded-xl shadow-border-xs p-4">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="min-w-0">
      <h2 class="text-sm font-medium text-primary"><%= t(".heading") %></h2>
      <p class="text-xs text-secondary mt-0.5"><%= t(".subtitle") %></p>
    </div>

    <% if editable %>
      <%= form_with model: budget, url: update_flex_budget_path(budget, **budget_owner_query), data: { controller: "auto-submit-form preserve-focus" } do |f| %>
        <div class="form-field w-[140px]">
          <div class="flex items-center privacy-sensitive privacy-sensitive-interactive">
            <span class="text-secondary text-sm mr-2"><%= currency.symbol %></span>
            <%= f.number_field :flex_spending,
                              value: budget.flex_spending&.to_s("F")&.sub(/\.?0+$/, ""),
                              class: "form-field__input text-right [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none",
                              placeholder: "0",
                              step: currency.step,
                              min: 0,
                              data: { auto_submit_form_target: "auto" },
                              aria: { label: t(".amount_label") } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <span class="text-lg font-medium text-primary tabular-nums privacy-sensitive">
        <%= budget.flex_configured? ? format_money(budget.flex_spending_money) : "—" %>
      </span>
    <% end %>
  </div>

  <% if budget.flex_configured? %>
    <div>
      <div class="flex h-1.5 mb-3 gap-1">
        <% if budget.flex_available_to_spend.negative? %>
          <div class="rounded-md h-1.5 bg-inverse" style="width: <%= 100 - budget.flex_overage_percent %>%"></div>
          <div class="rounded-md h-1.5 bg-destructive" style="width: <%= budget.flex_overage_percent %>%"></div>
        <% else %>
          <div class="rounded-md h-1.5 bg-inverse" style="width: <%= budget.flex_percent_spent %>%"></div>
          <div class="rounded-md h-1.5 bg-surface-inset" style="width: <%= 100 - budget.flex_percent_spent %>%"></div>
        <% end %>
      </div>
      <div class="flex justify-between text-sm privacy-sensitive">
        <p class="text-secondary"><%= t(".spent", amount: format_money(budget.flex_actual_spending_money)) %></p>
        <p class="font-medium">
          <% if budget.flex_available_to_spend.negative? %>
            <span class="text-destructive"><%= t(".over", amount: format_money(budget.flex_available_to_spend_money.abs)) %></span>
          <% else %>
            <span class="text-primary"><%= t(".left", amount: format_money(budget.flex_available_to_spend_money)) %></span>
          <% end %>
        </p>
      </div>
      <% if pacing %>
        <p class="text-xs text-secondary mt-1 privacy-sensitive">
          <%= t(".daily_pace", amount: pacing[:amount].format, days: pacing[:days_remaining]) %>
        </p>
      <% end %>
    </div>
  <% elsif editable %>
    <p class="text-sm text-secondary"><%= t(".unset_hint") %></p>
  <% end %>
</div>
