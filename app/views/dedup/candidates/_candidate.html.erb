<% winner = candidate.winner %>
<% loser = candidate.loser %>
<li class="p-4 space-y-3">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <% badge_class = { "high" => "bg-success/10 text-success", "medium" => "bg-warning/10 text-warning", "low" => "bg-container-inset text-secondary" }[candidate.confidence.to_s] %>
      <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= badge_class %>">
        <%= t(".confidence.#{candidate.confidence}") %>
      </span>
      <span class="text-xs text-secondary">
        <% if candidate.same_account? %>
          <%= t(".same_account") %>
        <% else %>
          <%= t(".cross_account") %>
        <% end %>
        &middot;
        <%= t(".days_apart", count: candidate.date_gap_days) %>
      </span>
    </div>
    <div class="flex items-center gap-2">
      <%= render DS::Link.new(
        text: t(".merge"),
        variant: "primary",
        size: "sm",
        icon: "combine",
        href: merge_dedup_candidates_path(entry_a_id: winner.id, entry_b_id: loser.id),
        data: { turbo_method: :post, turbo_confirm: t(".merge_confirm", keep: winner.name, drop: loser.name) }) %>
      <%= render DS::Link.new(
        text: t(".not_duplicate"),
        variant: "ghost",
        size: "sm",
        href: dismiss_dedup_candidates_path(entry_a_id: winner.id, entry_b_id: loser.id),
        data: { turbo_method: :post }) %>
    </div>
  </div>

  <div class="grid gap-2 sm:grid-cols-2">
    <% [ [ winner, :keep ], [ loser, :drop ] ].each do |entry, role| %>
      <% tx = entry.entryable %>
      <div class="rounded-lg border p-3 space-y-2 <%= role == :keep ? "border-primary bg-container-inset" : "border-divider" %>">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-medium <%= role == :keep ? "text-success" : "text-secondary" %> uppercase">
            <%= t(".#{role}") %>
          </span>
          <span class="text-xs text-subdued"><%= entry.source.presence || t(".manual_source") %></span>
        </div>
        <p class="text-sm font-medium text-primary truncate"><%= entry.name %></p>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-secondary">
          <span><%= entry.date %></span>
          <span class="<%= entry.amount.negative? ? "text-destructive" : "text-success" %>">
            <%= format_money(Money.new(entry.amount, entry.currency)) %>
          </span>
          <span><%= entry.account.name %></span>
          <% if tx.merchant %>
            <span><%= tx.merchant.name %></span>
          <% end %>
          <% if tx.category %>
            <span><%= tx.category.name %></span>
          <% end %>
          <% if tx.needs_review? %>
            <span class="text-warning"><%= t(".needs_review") %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</li>
